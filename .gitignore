/vendor/
/var/
/node_modules/
/drivers/
/composer.lock

/etc/build/*
!/etc/build/.gitignore

# Local overrides of the committed behat.yml.dist / phpunit.xml.dist.
/behat.yml
/phpunit.xml
/compose.override.yml

# PHPUnit 10 caches to a directory (cacheDirectory in phpunit.xml.dist);
# the .phpunit.result.cache entries are leftovers from the PHPUnit 9 layout.
/.phpunit.cache/
/.phpunit.result.cache
.phpunit.result.cache

# Symfony CLI https://symfony.com/doc/current/setup/symfony_server.html#different-php-settings-per-project
/.php-version
/php.ini

# Per-developer IDE settings. They belong to a machine, not to a published package.
/.idea/
/.vscode/
/*.iml

# Alternate data streams that Windows attaches to downloaded files; they surface
# as real files under WSL and would otherwise be committed.
*:Zone.Identifier

/tests/TestApplication/.env.local
/tests/TestApplication/.env.*.local

# Spec-Driven Development artifacts, kept out of the published package by choice.
# CLAUDE.md Rule 3 ("Specs are deliberately not published") states this decision and its
# consequences: the Rule 4 commit footer `Refs: specs/...` is a local navigation aid that
# resolves only in the author's working copy, and the specs are not backed up by this
# repository. This is intentional — do not "fix" it by committing /specs/.
/specs/

# Claude Code working files, kept out of the published package by choice — same reasoning
# as specs/ above. The skills are authoring tools for this repository, not part of what a
# consumer installs. settings.local.json is per-developer by convention in any case.
/.claude/skills/
/.claude/settings.local.json

###> graphify ###
# Upstream team-setup guidance: graphify-out/ is committed so everyone starts from the same map.
# Only cost.json is local-only; cache/ is offered as optional and skipped here to keep the repo
# small. manifest.json is portable (relative keys, re-anchored on load) so it stays tracked and
# saves a full rebuild on first checkout.
/graphify-out/cost.json
/graphify-out/cache/

# Not covered upstream, excluded on evidence rather than by the guide:
# - .graphify_root and .graphify_python hold absolute paths from the machine that built the graph
# - dated directories are full daily snapshots of the entire output, ~692K each
/graphify-out/.graphify_root
/graphify-out/.graphify_python
/graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
.claude/settings.json.graphify-bak
###< graphify ###
