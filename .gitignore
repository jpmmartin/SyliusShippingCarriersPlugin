/vendor/
/var/
/node_modules/
/drivers/
/composer.lock

/etc/build/*
!/etc/build/.gitignore

# Local overrides of the committed behat.yml.dist / phpunit.xml.dist.
/behat.yml
/phpunit.xml
/compose.override.yml

# PHPUnit 10 caches to a directory (cacheDirectory in phpunit.xml.dist);
# the .phpunit.result.cache entries are leftovers from the PHPUnit 9 layout.
/.phpunit.cache/
/.phpunit.result.cache
.phpunit.result.cache

# Symfony CLI https://symfony.com/doc/current/setup/symfony_server.html#different-php-settings-per-project
/.php-version
/php.ini

# Per-developer IDE settings. They belong to a machine, not to a published package.
/.idea/
/.vscode/
/*.iml

# Alternate data streams that Windows attaches to downloaded files; they surface
# as real files under WSL and would otherwise be committed.
*:Zone.Identifier

/tests/TestApplication/.env.local
/tests/TestApplication/.env.*.local

# Spec-Driven Development artifacts (OpenSpec: config.yaml, changes/, specs/, research/), kept out
# of the published package by choice. CLAUDE.md Rule 3 ("OpenSpec artifacts are deliberately not
# published") states this decision and its consequences: the Rule 4 commit footer `Refs:` is a
# local navigation aid that resolves only in the author's working copy, and the artifacts are not
# backed up by this repository. This is intentional — do not "fix" it by committing /openspec/.
/openspec/

# Claude Code working files, kept out of the published package by choice — same reasoning
# as openspec/ above. The skills are authoring tools for this repository, not part of what a
# consumer installs. settings.local.json is per-developer by convention in any case.
/.claude/skills/
/.claude/settings.local.json

###> graphify ###
# graphify is a local authoring tool, not part of the published package, and nothing
# it produces or configures belongs in the repository.
#
# The generated graph (graph.json, graph.html, GRAPH_REPORT.md) is a build artefact:
# it is regenerated from the sources on every update, so tracking it would grow the
# history with hundreds of kilobytes per rebuild while adding nothing a clone cannot
# recreate. The hooks and merge driver would also force graphify on anyone who clones
# this repo, and their tooling would fail without it installed.
/graphify-out/
/.gitattributes
/.claude/settings.json
/.claude/CLAUDE.md
.claude/settings.json.graphify-bak
###< graphify ###
