<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <defaults public="true" />

        <!-- No test calls UPS or FedEx: in the test environment both are fakes a scenario tells how to answer. -->
        <service id="jpmmartin_carrier.behat.fake_carrier_state" class="Tests\JpmMartin\SyliusShippingCarriersPlugin\Behat\Carrier\FakeCarrierState">
            <argument>%kernel.cache_dir%/jpmmartin_carrier_fake_carriers.json</argument>
        </service>

        <service id="jpmmartin_carrier.carrier.ups" class="Tests\JpmMartin\SyliusShippingCarriersPlugin\Behat\Carrier\FakeCarrier">
            <argument>ups</argument>
            <argument type="service" id="jpmmartin_carrier.behat.fake_carrier_state" />
            <tag name="jpmmartin_carrier.carrier" carrier="ups" />
        </service>

        <service id="jpmmartin_carrier.carrier.fedex" class="Tests\JpmMartin\SyliusShippingCarriersPlugin\Behat\Carrier\FakeCarrier">
            <argument>fedex</argument>
            <argument type="service" id="jpmmartin_carrier.behat.fake_carrier_state" />
            <tag name="jpmmartin_carrier.carrier" carrier="fedex" />
        </service>

        <!-- Issuing spends the merchant's money, so the label adapters are replaced too: no scenario may
             reach the real carrier by accident. -->
        <service id="jpmmartin_carrier.carrier.label.ups" class="Tests\JpmMartin\SyliusShippingCarriersPlugin\Behat\Carrier\FakeLabelCarrier">
            <argument>ups</argument>
            <argument type="service" id="jpmmartin_carrier.behat.fake_carrier_state" />
            <tag name="jpmmartin_carrier.label_carrier" carrier="ups" />
        </service>

        <service id="jpmmartin_carrier.carrier.label.fedex" class="Tests\JpmMartin\SyliusShippingCarriersPlugin\Behat\Carrier\FakeLabelCarrier">
            <argument>fedex</argument>
            <argument type="service" id="jpmmartin_carrier.behat.fake_carrier_state" />
            <tag name="jpmmartin_carrier.label_carrier" carrier="fedex" />
        </service>

        <!-- Hooks -->
        <service id="jpmmartin_carrier.behat.context.hook.carrier" class="Tests\JpmMartin\SyliusShippingCarriersPlugin\Behat\Context\Hook\CarrierContext">
            <argument type="service" id="jpmmartin_carrier.behat.fake_carrier_state" />
            <argument type="service" id="jpmmartin_carrier.cache.rates" />
            <argument type="service" id="jpmmartin_carrier.cache.tracking" />
            <argument>%sylius.behat.clock.date_file%</argument>
        </service>

        <service id="jpmmartin_carrier.behat.context.hook.database" class="Tests\JpmMartin\SyliusShippingCarriersPlugin\Behat\Context\Hook\DatabaseContext">
            <argument type="service" id="doctrine.orm.entity_manager" />
        </service>

        <!-- Setup -->
        <service id="jpmmartin_carrier.behat.context.setup.packaging" class="Tests\JpmMartin\SyliusShippingCarriersPlugin\Behat\Context\Setup\PackagingContext">
            <argument type="service" id="jpmmartin_carrier.factory.package_box" />
            <argument type="service" id="jpmmartin_carrier.repository.package_box" />
        </service>

        <service id="jpmmartin_carrier.behat.context.setup.shipping_origin" class="Tests\JpmMartin\SyliusShippingCarriersPlugin\Behat\Context\Setup\ShippingOriginContext">
            <argument type="service" id="sylius.behat.shared_storage" />
            <argument type="service" id="jpmmartin_carrier.factory.shipping_origin" />
            <argument type="service" id="jpmmartin_carrier.repository.shipping_origin" />
            <argument type="service" id="sylius.converter.country_name" />
        </service>

        <service id="jpmmartin_carrier.behat.context.setup.carrier" class="Tests\JpmMartin\SyliusShippingCarriersPlugin\Behat\Context\Setup\CarrierContext">
            <argument type="service" id="sylius.behat.shared_storage" />
            <argument type="service" id="jpmmartin_carrier.factory.credentials" />
            <argument type="service" id="jpmmartin_carrier.repository.credentials" />
            <argument type="service" id="sylius.fixture.example_factory.shipping_method" />
            <argument type="service" id="sylius.repository.shipping_method" />
            <argument type="service" id="jpmmartin_carrier.behat.fake_carrier_state" />
            <argument type="service" id="jpmmartin_carrier.cache.rates" />
            <argument type="service" id="sylius.behat.clock" />
            <argument>%sylius.behat.clock.date_file%</argument>
        </service>

        <service id="jpmmartin_carrier.behat.context.setup.customs" class="Tests\JpmMartin\SyliusShippingCarriersPlugin\Behat\Context\Setup\CustomsContext">
            <argument type="service" id="jpmmartin_carrier.factory.customs_data" />
            <argument type="service" id="jpmmartin_carrier.repository.customs_data" />
            <argument type="service" id="sylius.converter.country_name" />
        </service>

        <service id="jpmmartin_carrier.behat.context.setup.tracking" class="Tests\JpmMartin\SyliusShippingCarriersPlugin\Behat\Context\Setup\TrackingContext">
            <argument type="service" id="sylius.behat.shared_storage" />
            <argument type="service" id="sylius.repository.order" />
            <argument type="service" id="jpmmartin_carrier.behat.fake_carrier_state" />
        </service>

        <!-- Pages -->
        <service id="jpmmartin_carrier.behat.page.admin.carrier_credentials.create" class="Tests\JpmMartin\SyliusShippingCarriersPlugin\Behat\Page\Admin\CarrierCredentials\CreatePage" parent="sylius.behat.page.admin.crud.create" public="false">
            <argument type="string">jpmmartin_carrier_admin_credentials_create</argument>
        </service>

        <service id="jpmmartin_carrier.behat.page.admin.package_box.create" class="Tests\JpmMartin\SyliusShippingCarriersPlugin\Behat\Page\Admin\PackageBox\CreatePage" parent="sylius.behat.page.admin.crud.create" public="false">
            <argument type="string">jpmmartin_carrier_admin_package_box_create</argument>
        </service>

        <service id="jpmmartin_carrier.behat.page.admin.package_box.index" class="Sylius\Behat\Page\Admin\Crud\IndexPage" parent="sylius.behat.page.admin.crud.index" public="false">
            <argument type="string">jpmmartin_carrier_admin_package_box_index</argument>
        </service>

        <service id="jpmmartin_carrier.behat.page.admin.shipping_origin.create" class="Tests\JpmMartin\SyliusShippingCarriersPlugin\Behat\Page\Admin\ShippingOrigin\CreatePage" parent="sylius.behat.page.admin.crud.create" public="false">
            <argument type="string">jpmmartin_carrier_admin_shipping_origin_create</argument>
        </service>

        <service id="jpmmartin_carrier.behat.page.admin.shipping_origin.index" class="Sylius\Behat\Page\Admin\Crud\IndexPage" parent="sylius.behat.page.admin.crud.index" public="false">
            <argument type="string">jpmmartin_carrier_admin_shipping_origin_index</argument>
        </service>

        <!-- Sylius' own page of an order, with what this plugin adds to the shipment on it. -->
        <service id="jpmmartin_carrier.behat.page.admin.order.show" class="Tests\JpmMartin\SyliusShippingCarriersPlugin\Behat\Page\Admin\Order\ShowPage" parent="sylius.behat.page.admin.order.show" public="false" />

        <!-- Api -->
        <service id="jpmmartin_carrier.behat.context.api.admin.managing_carrier_shipping_methods" class="Tests\JpmMartin\SyliusShippingCarriersPlugin\Behat\Context\Api\Admin\ManagingCarrierShippingMethodsContext">
            <argument type="service" id="sylius.behat.api_platform_client.admin" />
            <argument type="service" id="Sylius\Behat\Client\ResponseCheckerInterface" />
            <argument type="service" id="sylius.repository.shipping_method" />
        </service>

        <!-- Domain -->
        <service id="jpmmartin_carrier.behat.context.domain.shipping_charge" class="Tests\JpmMartin\SyliusShippingCarriersPlugin\Behat\Context\Domain\ShippingChargeContext">
            <argument type="service" id="doctrine.orm.entity_manager" />
        </service>

        <!-- Ui -->
        <service id="jpmmartin_carrier.behat.context.ui.admin.managing_carrier_credentials" class="Tests\JpmMartin\SyliusShippingCarriersPlugin\Behat\Context\Ui\Admin\ManagingCarrierCredentialsContext">
            <argument type="service" id="jpmmartin_carrier.behat.page.admin.carrier_credentials.create" />
            <argument type="service" id="jpmmartin_carrier.repository.credentials" />
        </service>

        <service id="jpmmartin_carrier.behat.context.ui.admin.managing_package_boxes" class="Tests\JpmMartin\SyliusShippingCarriersPlugin\Behat\Context\Ui\Admin\ManagingPackageBoxesContext">
            <argument type="service" id="jpmmartin_carrier.behat.page.admin.package_box.create" />
            <argument type="service" id="jpmmartin_carrier.behat.page.admin.package_box.index" />
            <argument type="service" id="jpmmartin_carrier.repository.package_box" />
        </service>

        <service id="jpmmartin_carrier.behat.context.ui.admin.managing_shipping_origins" class="Tests\JpmMartin\SyliusShippingCarriersPlugin\Behat\Context\Ui\Admin\ManagingShippingOriginsContext">
            <argument type="service" id="jpmmartin_carrier.behat.page.admin.shipping_origin.create" />
            <argument type="service" id="jpmmartin_carrier.behat.page.admin.shipping_origin.index" />
            <argument type="service" id="jpmmartin_carrier.repository.shipping_origin" />
        </service>

        <service id="jpmmartin_carrier.behat.context.ui.admin.managing_carrier_labels" class="Tests\JpmMartin\SyliusShippingCarriersPlugin\Behat\Context\Ui\Admin\ManagingCarrierLabelsContext">
            <argument type="service" id="jpmmartin_carrier.behat.page.admin.order.show" />
            <argument type="service" id="jpmmartin_carrier.behat.fake_carrier_state" />
        </service>

        <service id="jpmmartin_carrier.behat.context.ui.shop.checkout" class="Tests\JpmMartin\SyliusShippingCarriersPlugin\Behat\Context\Ui\Shop\CheckoutContext">
            <argument type="service" id="behat.mink.default_session" />
            <argument type="service" id="behat.mink.parameters" />
            <argument type="service" id="router" />
            <argument type="service" id="jpmmartin_carrier.behat.fake_carrier_state" />
            <argument type="service" id="sylius.behat.page.shop.checkout.address" />
        </service>

        <service id="jpmmartin_carrier.behat.context.ui.shop.shipment_tracking" class="Tests\JpmMartin\SyliusShippingCarriersPlugin\Behat\Context\Ui\Shop\ShipmentTrackingContext">
            <argument type="service" id="behat.mink.default_session" />
            <argument type="service" id="jpmmartin_carrier.behat.fake_carrier_state" />
        </service>
    </services>
</container>
