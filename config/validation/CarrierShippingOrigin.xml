<?xml version="1.0" encoding="UTF-8"?>

<constraint-mapping
        xmlns="http://symfony.com/schema/dic/constraint-mapping"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://symfony.com/schema/dic/constraint-mapping http://symfony.com/schema/dic/services/constraint-mapping-1.0.xsd"
>
    <class name="JpmMartin\SyliusShippingCarriersPlugin\Entity\CarrierShippingOrigin">
        <!-- The database enforces one origin per channel (CA-2); this turns a violation into a form error. -->
        <constraint name="Symfony\Bridge\Doctrine\Validator\Constraints\UniqueEntity">
            <option name="fields">channel</option>
            <option name="message">jpmmartin_carrier.shipping_origin.channel.unique</option>
            <option name="groups">sylius</option>
        </constraint>

        <!-- Variant measures are shared by every channel, so every origin declares the same units (D-16). -->
        <constraint name="JpmMartin\SyliusShippingCarriersPlugin\Validator\Constraints\SameUnitsAsOtherOrigins">
            <option name="groups">sylius</option>
        </constraint>

        <property name="channel">
            <constraint name="NotBlank">
                <option name="groups">sylius</option>
            </constraint>
        </property>
        <property name="street">
            <constraint name="NotBlank">
                <option name="groups">sylius</option>
            </constraint>
        </property>
        <property name="city">
            <constraint name="NotBlank">
                <option name="groups">sylius</option>
            </constraint>
        </property>
        <property name="postcode">
            <constraint name="NotBlank">
                <option name="groups">sylius</option>
            </constraint>
        </property>
        <property name="countryCode">
            <constraint name="NotBlank">
                <option name="groups">sylius</option>
            </constraint>
        </property>
        <property name="weightUnit">
            <constraint name="Choice">
                <option name="choices">
                    <value>kg</value>
                    <value>lb</value>
                </option>
                <option name="groups">sylius</option>
            </constraint>
        </property>
        <property name="dimensionUnit">
            <constraint name="Choice">
                <option name="choices">
                    <value>cm</value>
                    <value>in</value>
                </option>
                <option name="groups">sylius</option>
            </constraint>
        </property>
        <property name="maxPackageWeight">
            <constraint name="Positive">
                <option name="groups">sylius</option>
            </constraint>
        </property>
    </class>
</constraint-mapping>
