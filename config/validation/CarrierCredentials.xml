<?xml version="1.0" encoding="UTF-8"?>

<constraint-mapping
        xmlns="http://symfony.com/schema/dic/constraint-mapping"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://symfony.com/schema/dic/constraint-mapping http://symfony.com/schema/dic/services/constraint-mapping-1.0.xsd"
>
    <class name="JpmMartin\SyliusShippingCarriersPlugin\Entity\CarrierCredentials">
        <!-- The database enforces one set per carrier; this turns a violation into a form error. -->
        <constraint name="Symfony\Bridge\Doctrine\Validator\Constraints\UniqueEntity">
            <option name="fields">carrier</option>
            <option name="message">jpmmartin_carrier.credentials.carrier.unique</option>
            <option name="groups">sylius</option>
        </constraint>

        <property name="carrier">
            <constraint name="NotBlank">
                <option name="groups">sylius</option>
            </constraint>
            <constraint name="Choice">
                <option name="choices">
                    <value>ups</value>
                    <value>fedex</value>
                </option>
                <option name="groups">sylius</option>
            </constraint>
        </property>

        <!-- Required and without a default: the environment is always an explicit choice. -->
        <property name="environment">
            <constraint name="NotBlank">
                <option name="message">jpmmartin_carrier.credentials.environment.not_blank</option>
                <option name="groups">sylius</option>
            </constraint>
            <constraint name="Choice">
                <option name="choices">
                    <value>sandbox</value>
                    <value>production</value>
                </option>
                <option name="groups">sylius</option>
            </constraint>
        </property>

        <!-- Required and without a default: it changes the price. -->
        <property name="pickupType">
            <constraint name="NotBlank">
                <option name="message">jpmmartin_carrier.credentials.pickup_type.not_blank</option>
                <option name="groups">sylius</option>
            </constraint>
            <constraint name="Choice">
                <option name="choices">
                    <value>scheduled</value>
                    <value>drop_off</value>
                    <value>on_demand</value>
                </option>
                <option name="groups">sylius</option>
            </constraint>
        </property>

        <property name="dutiesPayer">
            <constraint name="NotBlank">
                <option name="message">jpmmartin_carrier.credentials.duties_payer.not_blank</option>
                <option name="groups">sylius</option>
            </constraint>
            <constraint name="Choice">
                <option name="choices">
                    <value>recipient</value>
                    <value>shipper</value>
                </option>
                <option name="groups">sylius</option>
            </constraint>
        </property>

        <property name="credentials">
            <constraint name="Collection">
                <option name="fields">
                    <value key="client_id">
                        <constraint name="NotBlank">
                            <option name="groups">sylius</option>
                        </constraint>
                    </value>
                    <value key="client_secret">
                        <constraint name="NotBlank">
                            <option name="groups">sylius</option>
                        </constraint>
                    </value>
                </option>
                <option name="allowExtraFields">true</option>
                <!-- An empty value is not stored at all, so "missing" is how a blank field shows up. -->
                <option name="missingFieldsMessage">This value should not be blank.</option>
                <option name="groups">sylius</option>
            </constraint>
            <!-- A value the store could not decrypt is still its ciphertext: it has to be typed again, never kept. -->
            <constraint name="All">
                <option name="constraints">
                    <constraint name="Regex">
                        <option name="pattern">/#ENCRYPTED$/</option>
                        <option name="match">false</option>
                        <option name="message">jpmmartin_carrier.credentials.unreadable</option>
                        <option name="groups">sylius</option>
                    </constraint>
                </option>
                <option name="groups">sylius</option>
            </constraint>
            <!-- FedEx does not quote without an account number. -->
            <constraint name="When">
                <option name="expression">this.getCarrier() == 'fedex'</option>
                <option name="constraints">
                    <constraint name="Collection">
                        <option name="fields">
                            <value key="account_number">
                                <constraint name="NotBlank">
                                    <option name="message">jpmmartin_carrier.credentials.account_number.required_for_fedex</option>
                                    <option name="groups">sylius</option>
                                </constraint>
                            </value>
                        </option>
                        <option name="allowExtraFields">true</option>
                        <option name="missingFieldsMessage">jpmmartin_carrier.credentials.account_number.required_for_fedex</option>
                        <option name="groups">sylius</option>
                    </constraint>
                </option>
                <option name="groups">sylius</option>
            </constraint>
        </property>
    </class>
</constraint-mapping>
