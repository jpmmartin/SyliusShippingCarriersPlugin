<?xml version="1.0" encoding="UTF-8" ?>

<container
        xmlns="http://symfony.com/schema/dic/services"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd"
>
    <services>
        <service id="jpmmartin_carrier.form.type.shipping_origin" class="JpmMartin\SyliusShippingCarriersPlugin\Form\Type\CarrierShippingOriginType">
            <argument>%jpmmartin_carrier.model.shipping_origin.class%</argument>
            <argument type="collection">
                <argument>sylius</argument>
            </argument>
            <argument>%jpmmartin_carrier.model.package_box.class%</argument>
            <argument type="service" id="jpmmartin_carrier.settings" />
            <tag name="form.type" />
        </service>

        <service id="jpmmartin_carrier.form.type.package_box" class="JpmMartin\SyliusShippingCarriersPlugin\Form\Type\CarrierPackageBoxType">
            <argument>%jpmmartin_carrier.model.package_box.class%</argument>
            <argument type="collection">
                <argument>sylius</argument>
            </argument>
            <argument type="service" id="jpmmartin_carrier.resolver.store_units" />
            <tag name="form.type" />
        </service>

        <service id="jpmmartin_carrier.grid.admin_package_box" class="JpmMartin\SyliusShippingCarriersPlugin\Grid\PackageBoxGrid">
            <tag name="sylius.invokable_grid" />
        </service>

        <service id="jpmmartin_carrier.grid.admin_shipping_origin" class="JpmMartin\SyliusShippingCarriersPlugin\Grid\ShippingOriginGrid">
            <tag name="sylius.invokable_grid" />
        </service>

        <service id="jpmmartin_carrier.form.type.credentials" class="JpmMartin\SyliusShippingCarriersPlugin\Form\Type\CarrierCredentialsType">
            <argument>%jpmmartin_carrier.model.credentials.class%</argument>
            <argument type="collection">
                <argument>sylius</argument>
            </argument>
            <tag name="form.type" />
        </service>

        <service id="jpmmartin_carrier.form.type.credentials_data" class="JpmMartin\SyliusShippingCarriersPlugin\Form\Type\CarrierCredentialsDataType">
            <tag name="form.type" />
        </service>

        <service id="jpmmartin_carrier.grid.admin_credentials" class="JpmMartin\SyliusShippingCarriersPlugin\Grid\CarrierCredentialsGrid">
            <tag name="sylius.invokable_grid" />
        </service>

        <service id="jpmmartin_carrier.repository.incomplete_customs_data" class="JpmMartin\SyliusShippingCarriersPlugin\Repository\IncompleteCustomsDataRepository" public="true">
            <argument type="service" id="doctrine.orm.entity_manager" />
            <argument>%sylius.model.product_variant.class%</argument>
            <argument>%jpmmartin_carrier.model.customs_data.class%</argument>
        </service>

        <service id="jpmmartin_carrier.form.type.customs_data" class="JpmMartin\SyliusShippingCarriersPlugin\Form\Type\CarrierCustomsDataType">
            <argument>%jpmmartin_carrier.model.customs_data.class%</argument>
            <argument type="collection">
                <argument>sylius</argument>
            </argument>
            <tag name="form.type" />
        </service>

        <!-- The customs data of a variant is declared where the variant is edited. -->
        <service id="jpmmartin_carrier.form.extension.admin_product_variant" class="JpmMartin\SyliusShippingCarriersPlugin\Form\Extension\AdminProductVariantTypeExtension">
            <argument type="service" id="jpmmartin_carrier.repository.customs_data" />
            <argument type="service" id="jpmmartin_carrier.factory.customs_data" />
            <argument type="service" id="jpmmartin_carrier.manager.customs_data" />
            <tag name="form.type_extension" />
        </service>

        <service id="jpmmartin_carrier.listener.admin_menu" class="JpmMartin\SyliusShippingCarriersPlugin\Menu\AdminMenuListener">
            <tag name="kernel.event_listener" event="sylius.menu.admin.main" />
        </service>
    </services>
</container>
