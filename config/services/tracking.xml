<?xml version="1.0" encoding="UTF-8" ?>

<container
        xmlns="http://symfony.com/schema/dic/services"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd"
>
    <services>
        <service id="jpmmartin_carrier.tracking_provider" class="JpmMartin\SyliusShippingCarriersPlugin\Tracking\TrackingProvider">
            <argument type="service" id="jpmmartin_carrier.shipping.shipment_carrier" />
            <argument type="service" id="jpmmartin_carrier.carrier.credentials_provider" />
            <argument type="tagged_locator" tag="jpmmartin_carrier.carrier" index-by="carrier" />
            <argument type="service" id="jpmmartin_carrier.cache.tracking" />
            <argument type="service" id="logger" />
            <argument type="service" id="jpmmartin_carrier.settings" />
            <!-- A failure of a carrier is remembered for one request only. -->
            <tag name="kernel.reset" method="reset" />
        </service>
        <service id="JpmMartin\SyliusShippingCarriersPlugin\Tracking\TrackingProviderInterface" alias="jpmmartin_carrier.tracking_provider" />

        <service id="jpmmartin_carrier.twig.shipment_tracking_runtime" class="JpmMartin\SyliusShippingCarriersPlugin\Twig\ShipmentTrackingRuntime">
            <argument type="service" id="jpmmartin_carrier.shipping.shipment_carrier" />
            <argument type="service" id="jpmmartin_carrier.tracking_provider" />
            <tag name="twig.runtime" />
        </service>

        <service id="jpmmartin_carrier.twig.shipment_tracking_extension" class="JpmMartin\SyliusShippingCarriersPlugin\Twig\ShipmentTrackingExtension">
            <tag name="twig.extension" />
        </service>
    </services>
</container>
