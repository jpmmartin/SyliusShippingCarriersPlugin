<?xml version="1.0" encoding="UTF-8" ?>

<container
        xmlns="http://symfony.com/schema/dic/services"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd"
>
    <services>
        <!-- Public so integrators can encrypt their own carrier data with the same key. -->
        <service id="jpmmartin_carrier.encrypter" class="JpmMartin\SyliusShippingCarriersPlugin\Encryption\Encrypter" public="true">
            <argument>%env(resolve:JPMMARTIN_CARRIER_ENCRYPTION_KEY_PATH)%</argument>
        </service>
        <service id="JpmMartin\SyliusShippingCarriersPlugin\Encryption\EncrypterInterface" alias="jpmmartin_carrier.encrypter" />
    </services>
</container>
