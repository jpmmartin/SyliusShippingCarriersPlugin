<?xml version="1.0" encoding="UTF-8" ?>

<container
        xmlns="http://symfony.com/schema/dic/services"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd"
>
    <services>
        <service id="jpmmartin_carrier.packaging.box_selector" class="JpmMartin\SyliusShippingCarriersPlugin\Packaging\BoxSelector" />

        <service id="jpmmartin_carrier.packaging.fallback_packager" class="JpmMartin\SyliusShippingCarriersPlugin\Packaging\FallbackPackager" />

        <service id="jpmmartin_carrier.packaging_strategy.default" class="JpmMartin\SyliusShippingCarriersPlugin\Packaging\DefaultPackagingStrategy">
            <argument type="service" id="jpmmartin_carrier.repository.package_box" />
            <argument type="service" id="jpmmartin_carrier.packaging.box_selector" />
            <argument type="service" id="jpmmartin_carrier.packaging.fallback_packager" />
            <argument type="service" id="logger" />
        </service>

        <!-- The packages of a confirmed order are stored in the save that confirms it. -->
        <service id="jpmmartin_carrier.listener.store_shipment_packages" class="JpmMartin\SyliusShippingCarriersPlugin\EventListener\StoreShipmentPackagesListener">
            <argument type="service" id="sylius.registry.shipping_calculator" />
            <argument type="service" id="jpmmartin_carrier.packaging_strategy" />
            <argument type="service" id="jpmmartin_carrier.repository.shipping_origin" />
            <argument type="service" id="jpmmartin_carrier.factory.shipment_packaging" />
            <argument type="service" id="jpmmartin_carrier.factory.shipment_package" />
            <argument type="service" id="jpmmartin_carrier.manager.shipment_packaging" />
            <argument type="service" id="logger" />
            <tag name="kernel.event_listener" event="workflow.sylius_order_checkout.completed.complete" priority="50" />
        </service>

        <!-- Point this alias at another service to replace the packaging strategy. -->
        <service id="jpmmartin_carrier.packaging_strategy" alias="jpmmartin_carrier.packaging_strategy.default" />
        <service id="JpmMartin\SyliusShippingCarriersPlugin\Packaging\PackagingStrategyInterface" alias="jpmmartin_carrier.packaging_strategy" />
    </services>
</container>
