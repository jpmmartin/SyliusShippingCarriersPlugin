<?xml version="1.0" encoding="UTF-8" ?>

<container
        xmlns="http://symfony.com/schema/dic/services"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd"
>
    <services>
        <!-- The packages come from the ones stored when the order was confirmed, never from packing it again. -->
        <service id="jpmmartin_carrier.label.request_factory" class="JpmMartin\SyliusShippingCarriersPlugin\Label\ShipmentRequestFactory">
            <argument type="service" id="jpmmartin_carrier.repository.shipping_origin" />
            <argument type="service" id="jpmmartin_carrier.repository.shipment_packaging" />
            <argument type="service" id="jpmmartin_carrier.resolver.destination_type" />
            <argument type="service" id="jpmmartin_carrier.carrier.address_factory" />
            <argument type="service" id="jpmmartin_carrier.carrier.label_formats" />
            <argument type="service" id="jpmmartin_carrier.customs.data_provider" />
            <argument type="service" id="jpmmartin_carrier.customs.declared_value_calculator" />
            <argument type="service" id="clock" />
        </service>

        <!-- What was paid for what is inside, not what the catalogue asks for it. -->
        <service id="jpmmartin_carrier.customs.declared_value_calculator" class="JpmMartin\SyliusShippingCarriersPlugin\Customs\DeclaredValueCalculator" />

        <!-- A variant that cannot be declared stops the shipment before anything is asked of the carrier. -->
        <service id="jpmmartin_carrier.customs.data_provider" class="JpmMartin\SyliusShippingCarriersPlugin\Customs\CustomsDataProvider">
            <argument type="service" id="jpmmartin_carrier.repository.customs_data" />
        </service>

        <service id="jpmmartin_carrier.label.storage" class="JpmMartin\SyliusShippingCarriersPlugin\Label\LabelStorage">
            <argument type="service" id="jpmmartin_carrier.storage.documents" />
        </service>

        <service id="jpmmartin_carrier.label.issuer" class="JpmMartin\SyliusShippingCarriersPlugin\Label\LabelIssuer">
            <argument type="service" id="jpmmartin_carrier.shipping.shipment_carrier" />
            <argument type="tagged_locator" tag="jpmmartin_carrier.label_carrier" index-by="carrier" />
            <argument type="service" id="jpmmartin_carrier.label.request_factory" />
            <argument type="service" id="jpmmartin_carrier.carrier.credentials_provider" />
            <argument type="service" id="jpmmartin_carrier.label.storage" />
            <argument type="service" id="jpmmartin_carrier.repository.shipment_export" />
            <argument type="service" id="jpmmartin_carrier.factory.shipment_export" />
            <argument type="service" id="jpmmartin_carrier.factory.shipment_label" />
            <argument type="service" id="jpmmartin_carrier.manager.shipment_export" />
            <argument type="service" id="clock" />
            <argument type="service" id="logger" />
        </service>
        <service id="JpmMartin\SyliusShippingCarriersPlugin\Label\LabelIssuerInterface" alias="jpmmartin_carrier.label.issuer" />

        <!-- Issuing is always asked for from the admin, so it has its own action and its own route. -->
        <service id="jpmmartin_carrier.controller.admin.issue_labels" class="JpmMartin\SyliusShippingCarriersPlugin\Controller\Admin\IssueCarrierLabelsAction" public="true">
            <argument type="service" id="sylius.repository.shipment" />
            <argument type="service" id="jpmmartin_carrier.label.issuer" />
            <argument type="service" id="security.authorization_checker" />
            <argument type="service" id="security.csrf.token_manager" />
            <argument type="service" id="security.token_storage" />
            <argument type="service" id="router" />
        </service>

        <service id="jpmmartin_carrier.label.batch_issuer" class="JpmMartin\SyliusShippingCarriersPlugin\Label\BatchIssuer">
            <argument type="service" id="jpmmartin_carrier.label.issuer" />
            <argument type="service" id="logger" />
        </service>
        <service id="JpmMartin\SyliusShippingCarriersPlugin\Label\BatchIssuerInterface" alias="jpmmartin_carrier.label.batch_issuer" />

        <service id="jpmmartin_carrier.controller.admin.issue_labels_in_batch" class="JpmMartin\SyliusShippingCarriersPlugin\Controller\Admin\IssueCarrierLabelsInBatchAction" public="true">
            <argument type="service" id="sylius.repository.shipment" />
            <argument type="service" id="jpmmartin_carrier.label.batch_issuer" />
            <argument type="service" id="security.authorization_checker" />
            <argument type="service" id="security.csrf.token_manager" />
            <argument type="service" id="security.token_storage" />
            <argument type="service" id="router" />
        </service>

        <service id="jpmmartin_carrier.label.voider" class="JpmMartin\SyliusShippingCarriersPlugin\Label\LabelVoider">
            <argument type="tagged_locator" tag="jpmmartin_carrier.label_carrier" index-by="carrier" />
            <argument type="service" id="jpmmartin_carrier.manager.shipment_export" />
            <argument type="service" id="clock" />
            <argument type="service" id="logger" />
        </service>
        <service id="JpmMartin\SyliusShippingCarriersPlugin\Label\LabelVoiderInterface" alias="jpmmartin_carrier.label.voider" />

        <service id="jpmmartin_carrier.controller.admin.void_labels" class="JpmMartin\SyliusShippingCarriersPlugin\Controller\Admin\VoidCarrierLabelsAction" public="true">
            <argument type="service" id="sylius.repository.shipment" />
            <argument type="service" id="jpmmartin_carrier.repository.shipment_export" />
            <argument type="service" id="jpmmartin_carrier.label.voider" />
            <argument type="service" id="security.authorization_checker" />
            <argument type="service" id="security.csrf.token_manager" />
            <argument type="service" id="security.token_storage" />
            <argument type="service" id="router" />
        </service>

        <!-- By the label's own record, not by a path: what may be downloaded depends on what happened to it. -->
        <service id="jpmmartin_carrier.controller.admin.download_label" class="JpmMartin\SyliusShippingCarriersPlugin\Controller\Admin\DownloadCarrierLabelAction" public="true">
            <argument type="service" id="jpmmartin_carrier.repository.shipment_label" />
            <argument type="service" id="jpmmartin_carrier.controller.admin.download_document" />
        </service>

        <service id="jpmmartin_carrier.controller.admin.download_customs_document" class="JpmMartin\SyliusShippingCarriersPlugin\Controller\Admin\DownloadCarrierCustomsDocumentAction" public="true">
            <argument type="service" id="jpmmartin_carrier.repository.shipment_export" />
            <argument type="service" id="jpmmartin_carrier.controller.admin.download_document" />
        </service>

        <!-- Ninety days in UPS against twelve hours in FedEx: the screen has to say which one this is. -->
        <service id="jpmmartin_carrier.label.void_window" class="JpmMartin\SyliusShippingCarriersPlugin\Label\VoidWindow">
            <argument type="service" id="clock" />
        </service>

        <service id="jpmmartin_carrier.twig.shipment_labels_runtime" class="JpmMartin\SyliusShippingCarriersPlugin\Twig\ShipmentLabelsRuntime">
            <argument type="service" id="jpmmartin_carrier.shipping.shipment_carrier" />
            <argument type="service" id="jpmmartin_carrier.repository.shipment_export" />
            <argument type="service" id="jpmmartin_carrier.label.void_window" />
            <tag name="twig.runtime" />
        </service>

        <service id="jpmmartin_carrier.twig.shipment_labels_extension" class="JpmMartin\SyliusShippingCarriersPlugin\Twig\ShipmentLabelsExtension">
            <tag name="twig.extension" />
        </service>
    </services>
</container>
