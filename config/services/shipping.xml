<?xml version="1.0" encoding="UTF-8" ?>

<container
        xmlns="http://symfony.com/schema/dic/services"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd"
>
    <services>
        <service id="jpmmartin_carrier.shipping.carrier_services" class="JpmMartin\SyliusShippingCarriersPlugin\Shipping\CarrierServices">
            <argument>%jpmmartin_carrier.services%</argument>
        </service>

        <service id="jpmmartin_carrier.shipping.shipment_carrier" class="JpmMartin\SyliusShippingCarriersPlugin\Shipping\ShipmentCarrier">
            <argument type="service" id="sylius.registry.shipping_calculator" />
        </service>

        <service id="jpmmartin_carrier.shipping.charge_resolver" class="JpmMartin\SyliusShippingCarriersPlugin\Shipping\ShippingChargeResolver">
            <argument type="service" id="jpmmartin_carrier.rate_provider" />
        </service>

        <service id="jpmmartin_carrier.shipping.eligibility_checker" class="JpmMartin\SyliusShippingCarriersPlugin\Shipping\Eligibility\CarrierRateEligibilityChecker">
            <argument type="service" id="sylius.registry.shipping_calculator" />
            <argument type="service" id="jpmmartin_carrier.shipping.charge_resolver" />
            <tag name="sylius.shipping_method_eligibility_checker" />
        </service>

        <!-- After Sylius's shipping charges processor, priority 30, which creates the shipping adjustment. -->
        <service id="jpmmartin_carrier.order_processing.shipping_charge_source" class="JpmMartin\SyliusShippingCarriersPlugin\OrderProcessing\ShippingChargeSourceProcessor">
            <argument type="service" id="sylius.registry.shipping_calculator" />
            <argument type="service" id="jpmmartin_carrier.shipping.charge_resolver" />
            <tag name="sylius.order_processor" priority="25" />
        </service>

        <service id="jpmmartin_carrier.shipping_calculator.ups_rate" class="JpmMartin\SyliusShippingCarriersPlugin\Shipping\Calculator\CarrierRateCalculator">
            <argument type="service" id="jpmmartin_carrier.shipping.charge_resolver" />
            <argument>ups</argument>
            <argument>ups_rate</argument>
            <tag
                name="sylius.shipping_calculator"
                calculator="ups_rate"
                form_type="JpmMartin\SyliusShippingCarriersPlugin\Form\Type\Shipping\UpsRateConfigurationType"
                label="jpmmartin_carrier.form.shipping_calculator.ups_rate"
            />
        </service>

        <service id="jpmmartin_carrier.shipping_calculator.fedex_rate" class="JpmMartin\SyliusShippingCarriersPlugin\Shipping\Calculator\CarrierRateCalculator">
            <argument type="service" id="jpmmartin_carrier.shipping.charge_resolver" />
            <argument>fedex</argument>
            <argument>fedex_rate</argument>
            <tag
                name="sylius.shipping_calculator"
                calculator="fedex_rate"
                form_type="JpmMartin\SyliusShippingCarriersPlugin\Form\Type\Shipping\FedexRateConfigurationType"
                label="jpmmartin_carrier.form.shipping_calculator.fedex_rate"
            />
        </service>

        <service id="jpmmartin_carrier.form.type.shipping.carrier_rate_configuration" class="JpmMartin\SyliusShippingCarriersPlugin\Form\Type\Shipping\CarrierRateConfigurationType">
            <argument type="service" id="jpmmartin_carrier.shipping.carrier_services" />
            <tag name="form.type" />
        </service>

        <service id="jpmmartin_carrier.form.type.shipping.ups_rate_configuration" class="JpmMartin\SyliusShippingCarriersPlugin\Form\Type\Shipping\UpsRateConfigurationType">
            <tag name="form.type" />
        </service>

        <service id="jpmmartin_carrier.form.type.shipping.fedex_rate_configuration" class="JpmMartin\SyliusShippingCarriersPlugin\Form\Type\Shipping\FedexRateConfigurationType">
            <tag name="form.type" />
        </service>
    </services>
</container>
