<?xml version="1.0" encoding="UTF-8" ?>

<container
        xmlns="http://symfony.com/schema/dic/services"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd"
>
    <services>
        <service id="jpmmartin_carrier.carrier.credentials_provider" class="JpmMartin\SyliusShippingCarriersPlugin\Carrier\CredentialsProvider">
            <argument type="service" id="jpmmartin_carrier.repository.credentials" />
        </service>

        <!-- PSR-18 over Symfony's client, with the carrier timeout. -->
        <service id="jpmmartin_carrier.carrier.http_client" class="Psr\Http\Client\ClientInterface">
            <factory class="JpmMartin\SyliusShippingCarriersPlugin\Carrier\CarrierHttpClientFactory" method="create" />
            <argument type="service" id="http_client" />
            <argument>%jpmmartin_carrier.carrier_timeout%</argument>
        </service>

        <!-- Shared by every process, so a carrier's access token is requested once per lifetime. -->
        <service id="jpmmartin_carrier.cache.access_token" parent="cache.adapter.filesystem">
            <tag name="cache.pool" />
        </service>

        <service id="jpmmartin_carrier.carrier.ups.access_token_cache" class="JpmMartin\SyliusShippingCarriersPlugin\Carrier\Ups\UpsAccessTokenCache">
            <argument type="service" id="jpmmartin_carrier.cache.access_token" />
            <argument type="service" id="jpmmartin_carrier.encrypter" />
        </service>

        <service id="jpmmartin_carrier.carrier.ups.client_factory" class="JpmMartin\SyliusShippingCarriersPlugin\Carrier\Ups\UpsClientFactory">
            <argument type="service" id="jpmmartin_carrier.carrier.http_client" />
            <argument type="service" id="jpmmartin_carrier.carrier.ups.access_token_cache" />
            <argument type="service" id="lock.factory" />
        </service>

        <service id="jpmmartin_carrier.carrier.ups" class="JpmMartin\SyliusShippingCarriersPlugin\Carrier\Ups\UpsCarrier">
            <argument type="service" id="jpmmartin_carrier.carrier.credentials_provider" />
            <argument type="service" id="jpmmartin_carrier.carrier.ups.client_factory" />
            <tag name="jpmmartin_carrier.carrier" carrier="ups" />
        </service>

        <service id="jpmmartin_carrier.carrier.label_formats" class="JpmMartin\SyliusShippingCarriersPlugin\Carrier\Label\LabelFormats">
            <argument>%jpmmartin_carrier.label_formats%</argument>
        </service>

        <service id="jpmmartin_carrier.carrier.fedex.connector_factory" class="JpmMartin\SyliusShippingCarriersPlugin\Carrier\Fedex\FedexConnectorFactory">
            <argument type="service" id="jpmmartin_carrier.cache.access_token" />
            <argument type="service" id="jpmmartin_carrier.encrypter" />
            <argument type="service" id="lock.factory" />
            <argument>%jpmmartin_carrier.carrier_timeout%</argument>
        </service>

        <service id="jpmmartin_carrier.carrier.fedex" class="JpmMartin\SyliusShippingCarriersPlugin\Carrier\Fedex\FedexCarrier">
            <argument type="service" id="jpmmartin_carrier.carrier.credentials_provider" />
            <argument type="service" id="jpmmartin_carrier.carrier.fedex.connector_factory" />
            <tag name="jpmmartin_carrier.carrier" carrier="fedex" />
        </service>
    </services>
</container>
