{
    "name": "jpmmartin/sylius-shipping-carriers-plugin",
    "type": "sylius-plugin",
    "description": "UPS and FedEx shipping for Sylius: real-time rates, labels, tracking and customs",
    "keywords": [
        "sylius",
        "sylius-plugin",
        "shipping",
        "carrier",
        "ups",
        "fedex"
    ],
    "license": "MIT",
    "support": {
        "issues": "https://github.com/jpmmartin/SyliusShippingCarriersPlugin/issues",
        "source": "https://github.com/jpmmartin/SyliusShippingCarriersPlugin"
    },
    "require": {
        "php": "^8.2",
        "paragonie/halite": "^5.0",
        "shipstream/fedex-rest-sdk": "^1.6",
        "league/flysystem-bundle": "^3.3",
        "shipstream/ups-rest-php-sdk": "^2.3",
        "sylius/sylius": "^2.2.6",
        "symfony/lock": "^6.4 || ^7.4"
    },
    "require-dev": {
        "behat/behat": "^3.16",
        "dbrekelmans/bdi": "^1.4",
        "dmore/behat-chrome-extension": "^1.4",
        "dmore/chrome-mink-driver": "^2.9",
        "friends-of-behat/mink": "^1.11",
        "friends-of-behat/mink-browserkit-driver": "^1.6",
        "friends-of-behat/mink-debug-extension": "^2.1",
        "friends-of-behat/mink-extension": "^2.7",
        "friends-of-behat/page-object-extension": "^0.3",
        "friends-of-behat/suite-settings-extension": "^1.1",
        "friends-of-behat/symfony-extension": "^2.6",
        "friends-of-behat/variadic-extension": "^1.6",
        "nyholm/psr7": "^1.8",
        "phpstan/phpstan": "^1.12",
        "phpstan/phpstan-doctrine": "^1.3",
        "phpstan/phpstan-webmozart-assert": "^1.2",
        "phpunit/phpunit": "^10.5",
        "sylius-labs/coding-standard": "^4.4",
        "sylius-labs/suite-tags-extension": "~0.2",
        "sylius/sylius-rector": "^2.0",
        "sylius/test-application": "^2.0.0@alpha",
        "symfony/browser-kit": "^6.4 || ^7.4",
        "symfony/debug-bundle": "^6.4 || ^7.4",
        "symfony/dotenv": "^6.4 || ^7.4",
        "symfony/http-client": "^6.4 || ^7.4",
        "symfony/intl": "^6.4 || ^7.4",
        "symfony/runtime": "^6.4 || ^7.4",
        "symfony/web-profiler-bundle": "^6.4 || ^7.4",
        "symfony/webpack-encore-bundle": "^2.2"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": false,
            "php-http/discovery": false,
            "phpstan/extension-installer": true,
            "symfony/flex": true,
            "symfony/runtime": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0-dev"
        },
        "symfony": {
            "require": "^7.4"
        },
        "public-dir": "vendor/sylius/test-application/public"
    },
    "autoload": {
        "psr-4": {
            "JpmMartin\\SyliusShippingCarriersPlugin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\JpmMartin\\SyliusShippingCarriersPlugin\\": [
                "tests/",
                "tests/TestApplication/src/"
            ]
        }
    },
    "scripts": {
        "check": [
            "@ecs",
            "@phpstan",
            "@lint-container",
            "@phpunit",
            "@behat"
        ],
        "ecs": "vendor/bin/ecs check",
        "phpstan": "vendor/bin/phpstan analyse",
        "lint-container": "vendor/bin/console lint:container",
        "phpunit": "vendor/bin/phpunit",
        "behat": "vendor/bin/behat --strict --no-interaction",
        "database-reset": [
            "vendor/bin/console doctrine:database:drop --force --if-exists",
            "vendor/bin/console doctrine:database:create",
            "vendor/bin/console doctrine:migration:migrate -n",
            "vendor/bin/console sylius:fixtures:load -n"
        ],
        "frontend-clear": [
            "cd vendor/sylius/test-application && yarn install && yarn build",
            "vendor/bin/console assets:install"
        ],
        "test-app-init": [
            "@database-reset",
            "@frontend-clear"
        ]
    },
    "scripts-descriptions": {
        "check": "ECS, PHPStan, the container lint, PHPUnit and Behat, stopping at the first failure. What a pull request has to pass",
        "ecs": "Coding standard (sylius-labs/coding-standard), check only; add --fix to apply",
        "phpstan": "Static analysis of src/ and tests/ at the level set in phpstan.neon",
        "lint-container": "Every service argument matches the type its constructor declares",
        "phpunit": "PHPUnit suites (Unit, Integration, Functional); needs the test database migrated",
        "behat": "Behat scenarios, none of which needs a browser; needs the test database migrated and the test application built",
        "database-reset": "Drops, creates and migrates the database of the test application, then loads the fixtures",
        "frontend-clear": "Builds the front end of the test application and installs its assets",
        "test-app-init": "database-reset, then frontend-clear"
    }
}
