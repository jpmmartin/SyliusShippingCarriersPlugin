{# Only for a shipment sent by a carrier of this plugin: another shipping method is offered nothing. #}
{% set shipment = hookable_metadata.context.shipment %}
{% set labels = jpmmartin_carrier_shipment_labels(shipment) %}

{% if labels is not null %}
    {% if labels.canBeIssued() %}
        <form method="post" action="{{ path('jpmmartin_carrier_admin_shipment_issue_labels', {'id': shipment.id}) }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('jpmmartin_carrier_issue_labels') }}">
            <button type="submit" class="btn btn-icon" data-bs-toggle="tooltip" data-bs-title="{{ 'jpmmartin_carrier.ui.labels.issue'|trans }}" {{ sylius_test_html_attribute('jpmmartin-carrier-issue-labels-button') }}>
                {{ ux_icon('tabler:tag') }}
            </button>
        </form>
    {% elseif labels.needsCheck() %}
        <span class="badge bg-warning" data-bs-toggle="tooltip" data-bs-title="{{ labels.failureReason() }}" {{ sylius_test_html_attribute('jpmmartin-carrier-labels-need-check') }}>
            {{ 'jpmmartin_carrier.ui.labels.needs_check'|trans }}
        </span>
    {% else %}
        {% for label in labels.downloadable() %}
            <a href="{{ path('jpmmartin_carrier_admin_label_download', {'id': label.id}) }}" class="btn btn-icon" data-bs-toggle="tooltip" data-bs-title="{{ 'jpmmartin_carrier.ui.labels.download'|trans }}" {{ sylius_test_html_attribute('jpmmartin-carrier-label-download-link') }}>
                {{ ux_icon('tabler:file-download') }}
            </a>
        {% endfor %}
        <form method="post" action="{{ path('jpmmartin_carrier_admin_shipment_void_labels', {'id': shipment.id}) }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('jpmmartin_carrier_void_labels') }}">
            <button type="submit" class="btn btn-icon" data-bs-toggle="tooltip" data-bs-title="{{ 'jpmmartin_carrier.ui.labels.void'|trans }}" {{ sylius_test_html_attribute('jpmmartin-carrier-void-labels-button') }}>
                {{ ux_icon('tabler:tag-off') }}
            </button>
        </form>
    {% endif %}
{% endif %}
